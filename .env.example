# ──────────────────────────────────────────────────────────────────────────────
# Duoplus Dashboard — Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────────────────────

# Duoplus API key (required — get from app.duoplus.io → API Keys)
DUOPLUS_API_KEY=your_duoplus_api_key_here

# ── Turso cloud database (shared across all teammates) ───────────────────────
# Get these from https://turso.tech after creating a database.
# Leave blank to use a LOCAL SQLite file at ./data/dashboard.sqlite instead.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ── Optional: local SQLite path (only used when TURSO_DATABASE_URL is not set) ─
# DB_PATH=./data/dashboard.sqlite

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3030

# ── Claude / Anthropic (for screen analysis + self-healing automation) ───────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Live device streams (ws-scrcpy sidecar) ──────────────────────────────────
# When STREAMS_ENABLED=true, the dashboard exposes a "Live Streams" tab with
# toggleable per-device video tiles powered by ws-scrcpy (real H.264 video,
# ~30 fps). ws-scrcpy is NOT bundled — install + run it separately:
#
#   git clone https://github.com/NetrisTV/ws-scrcpy.git
#   cd ws-scrcpy && npm install && npm start
#
# Then point WS_SCRCPY_URL at where it's listening (default http://localhost:8000).
# Streams default to OFF in the UI; user must Start each tile (each running
# tile is ~50–100 MB browser memory). Stop the tile to free.
STREAMS_ENABLED=false
WS_SCRCPY_URL=http://localhost:8000
