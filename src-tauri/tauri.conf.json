{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duoplus Dashboard",
  "version": "0.1.0",
  "identifier": "com.duoplus.dashboard",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3030",
    "beforeBuildCommand": "bun run build:server",
    "frontendDist": "../index.html"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Duoplus Dashboard",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "decorations": true,
        "url": "http://localhost:3030"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/server-bin"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
